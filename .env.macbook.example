# VoiceStorage single-Mac test configuration.
# Copy to .env.macbook and replace every change-* value before starting.

# OpenRouter — keep this key server-side; never prefix it with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
# Vision model — image labeling / ingestion.
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
# Chat model — conversational voice search (tool calling). Must support tools.
# Leave blank to disable the LLM layer (voice falls back to plain hybrid search).
OPENROUTER_CHAT_MODEL=google/gemini-2.5-flash

# Optional session key for the conversational + voice endpoints. When set, the
# browser must present it via the `invstorage_session` cookie. Leave blank for
# local/dev (auth bypassed, matching API-route behavior).
INVSTORAGE_API_KEY=

# SerpAPI key for item research (web search + price lookup).
# Get a free key at https://serpapi.com (100 searches/month free).
SERPAPI_KEY=

# Local service credentials
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-database-password
MINIO_ROOT_USER=voicestorage
MINIO_ROOT_PASSWORD=change-minio-password
VAULT_USER=vault
VAULT_PASSWORD=change-vault-password

# Host ports are intentionally different from the original InvStorage stack.
VOICESTORAGE_APP_PORT=3100
VOICESTORAGE_DB_PORT=5542
VOICESTORAGE_REDIS_PORT=6479
VOICESTORAGE_MINIO_PORT=9100
VOICESTORAGE_MINIO_CONSOLE_PORT=9101
VOICESTORAGE_CLIP_PORT=8200
VOICESTORAGE_VAULT_PORT=5546
