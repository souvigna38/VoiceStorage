# =============================================================================
# Personal Inventory Portable — Environment Variables
# =============================================================================
# Copy this to .env and fill in real values before starting.
# =============================================================================

# --- AI Agent (OpenClaw) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENCLAW_GATEWAY_TOKEN=your-gateway-token

# --- MSRP Lookup (SerpAPI — optional) ---
SERPAPI_KEY=your-serpapi-key

# --- API Authentication (optional — leave blank to disable) ---
# Set this to a random string to require API key auth on all routes
INVSTORAGE_API_KEY=

# =============================================================================
# The values below are pre-configured for Docker Compose and generally
# do not need changing unless you modify the compose file.
# =============================================================================

# --- Main Database ---
DATABASE_URL=postgresql://admin:secure_password@db:5432/inventory?schema=public

# --- Vault Backup Database ---
VAULT_DATABASE_URL=postgresql://vault:vault_secret@vault-db:5432/vault_spm1

# --- MinIO Object Storage ---
MINIO_ENDPOINT=storage
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=inventory
MINIO_USE_SSL=false
NEXT_PUBLIC_MINIO_ENDPOINT=http://localhost:9000
NEXT_PUBLIC_MINIO_BUCKET=inventory-images

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Ollama AI ---
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llava

# --- CLIP Service ---
CLIP_SERVICE_URL=http://clip-service:8000

# --- OpenRouter (external AI) ---
# Vision model labels photos; chat model powers conversational voice search
# via allowlisted read-only tools. Chat model must support tool calling.
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
OPENROUTER_CHAT_MODEL=google/gemini-2.5-flash

# Optional session key guarding conversational + voice server actions.
# When set, browser must send it as the `invstorage_session` cookie.
INVSTORAGE_API_KEY=

# --- Medusa Sales Backend ---
MEDUSA_BACKEND_URL=http://medusa:9000
MEDUSA_ADMIN_EMAIL=admin@invstorage.local
MEDUSA_ADMIN_PASSWORD=invtrack123

# --- QR Code Base URL ---
NEXT_PUBLIC_HOST_IP=localhost

# --- Data Lake ---
DATALAKE_USER=datalake
DATALAKE_PASSWORD=datalake_secret

# --- Service Dashboard URLs (for frontend links) ---
NEXT_PUBLIC_MEDUSA_URL=http://localhost:9500
NEXT_PUBLIC_N8N_URL=http://localhost:5678
NEXT_PUBLIC_ERPNEXT_URL=http://localhost:8090
NEXT_PUBLIC_OPENCLAW_URL=http://localhost:18789
NEXT_PUBLIC_ADMINER_URL=http://localhost:8080
NEXT_PUBLIC_NOCODB_URL=http://localhost:8086
