# =============================================================================
# InvStorage — Root .gitignore
# =============================================================================

# ── Environment / Secrets ────────────────────────────────────────────────────
.env
.env.local
.env.production
.env.macbook
# Keep .env.example (template for new installs — no real secrets)
!.env.example
!.env.macbook.example

# ── Node / Next.js ───────────────────────────────────────────────────────────
node_modules/
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
coverage/
.vercel

# ── Prisma Generated Client ───────────────────────────────────────────────────
frontend/src/generated/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
*.egg
.venv/
venv/
.Python
pip-log.txt

# ── Docker / Data Volumes ─────────────────────────────────────────────────────
pg_data/
minio_data/
redis_data/
backend/pg_data/
backend/minio_data/

# ── Large Binary Blobs ────────────────────────────────────────────────────────
# Database and storage tarballs — re-generate with ./scripts/backup.sh
backend/*.tar.gz
data/migration_*/

# ── Photo Inbox (personal photos — NOT for version control) ──────────────────
photo-inbox/processed/
photo-inbox/*.jpg
photo-inbox/*.jpeg
photo-inbox/*.png
photo-inbox/*.heic
photo-inbox/*.HEIC
photo-inbox/*.webp

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# ── Editor ────────────────────────────────────────────────────────────────────
.idea/
*.swp
*.swo
*.pem
